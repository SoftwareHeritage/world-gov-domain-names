{:paths ["scripts"]
 :tasks
 {:requires ([babashka.process :refer [shell]])
  ;; run a script and exit with its code: shell would print a stack
  ;; trace on every non-zero exit (an unknown sub-command, a failed check)
  :init (defn run [script & args]
          (System/exit (:exit (apply shell {:continue true} "bb" script args))))
  pipeline   {:doc  "Full pipeline -- run 'bb pipeline help' for usage"
              :task (apply run "scripts/pipeline.clj" *command-line-args*)}
  collect    {:doc  "the harvest: fetch (+ retry) + normalize + probe + mx + probe-roots -> sources/harvest/, data/.db"
              :task (apply run "scripts/pipeline.clj" "collect" *command-line-args*)}
  enrich     {:doc  "build-qid + build-gec + build-un-ids + subdivisions, then wikidata (+ academia) + ror/sopc/iana/cia/un-desa/oecd/meta (parallel)"
              :task (apply run "scripts/pipeline.clj" "enrich" *command-line-args*)}
  build      {:doc  "the consolidated files: aggregate + domains -> data/ (after enrich)"
              :task (apply run "scripts/pipeline.clj" "build" *command-line-args*)}
  report     {:doc  "the curation files: propose + summary -> proposed.csv, to_curate.csv, summary.md (after build)"
              :task (apply run "scripts/pipeline.clj" "report" *command-line-args*)}
  indegree   {:doc  "link-graph in-degree (eu-plus-government-scans) -> sources/linkgraph/"
              :task (apply run "scripts/pipeline.clj" "indegree" *command-line-args*)}
  directories {:doc  "official directories of public bodies: 'registry' -> sources/<registry>/registered.csv, 'candidates' -> sources/directory/orgs.csv -- run 'bb directories help'"
               :task (apply run "scripts/detect-from-directories.clj" *command-line-args*)}
  todo       {:doc  "refresh to_curate.csv after a curation, offline: bb todo [FRA…]"
              :task (apply run "scripts/pipeline.clj" "todo" *command-line-args*)}
  check      {:doc  "check the hand-edited files: bb check [FRA…] (every country by default)"
              :task (apply run "scripts/pipeline.clj" "check" *command-line-args*)}
  all        {:doc  "collect + enrich + build + report"
              :task (apply run "scripts/pipeline.clj" "all" *command-line-args*)}}}
