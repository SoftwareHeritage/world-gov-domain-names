{:paths ["scripts"]
 :tasks
 {:requires ([babashka.process :refer [shell]])
  pipeline   {:doc  "Full pipeline -- run 'bb pipeline help' for usage"
              :task (apply shell "bb scripts/pipeline.clj" *command-line-args*)}
  collect    {:doc  "crt.sh harvest + normalize + probe + aggregate"
              :task (apply shell "bb scripts/pipeline.clj collect" *command-line-args*)}
  enrich     {:doc  "wikidata + iana/cia/un-desa/oecd/meta (parallel)"
              :task (apply shell "bb scripts/pipeline.clj enrich" *command-line-args*)}
  report     {:doc  "cross-check: candidates.csv + summary.md"
              :task (apply shell "bb scripts/pipeline.clj report" *command-line-args*)}
  indegree   {:doc  "link-graph in-degree (eu-plus-government-scans) -> sources/linkgraph/"
              :task (apply shell "bb scripts/pipeline.clj indegree" *command-line-args*)}
  forges     {:doc  "forge/catalog detection for swh-sopc-data-sources -- run 'bb forges help'"
              :task (apply shell "bb scripts/detect-forges.clj" *command-line-args*)}
  universities {:doc  "public-universities harvest (parked dataset) -- run 'bb universities help'"
                :task (apply shell "bb scripts/detect-universities.clj" *command-line-args*)}
  directories {:doc  "harvest official directories of public bodies -> registry/candidates"
               :task (apply shell "bb scripts/detect-from-directories.clj" *command-line-args*)}
  all        {:doc  "collect + enrich + report"
              :task (apply shell "bb scripts/pipeline.clj all" *command-line-args*)}}}
