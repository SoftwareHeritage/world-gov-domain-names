;; Per-country specs of the machine-readable directories of public
;; bodies, harvested by scripts/detect-from-directories.clj
;; (bb directories). Keys are ISO 3166-1 alpha-2 codes, mapped to
;; countries/<ISO3>_<slug> through data/world-governments.csv. Each
;; :url (or :list-url) must match an 'api:' or 'data:' entry of
;; sources_domains.yaml in swh-sopc-data-sources, query string aside:
;; 'bb directories check' compares them. Sources left out on purpose
;; are listed with their reason in sources_domains_maybe.yaml.
;;
;; :channel picks where the hosts land:
;;   :registry   -- the directory's central-government scoping is
;;                  authoritative (organisation-form filter, federal-only
;;                  export): sources/<:registry>/registered.csv, the
;;                  domains confirmed directly. :host-filter guards
;;                  against off-TLD entries (a stray sites.google.com
;;                  must never become a confirmed root).
;;   :candidates -- the directory mixes levels or types without a
;;                  reliable marker: sources/directory/orgs.csv, feeding
;;                  proposed.csv with a strong score bonus; curation
;;                  decides.
;;
;; :format picks the fetcher and the keys it reads:
;;   :csv         :url :name-col :website-col, optional :encoding
;;                (default UTF-8), :separator (default ","), :col-filters
;;   :xlsx        :url :name-col :website-col, optional :col-filters
;;                (first sheet, header on the first row)
;;   :json        :url :items-path ([] for a top-level array) :name-field
;;                :website-field, optional :item-filters, :query-params
;;                (a map) and :website-json-key (the website field is a
;;                JSON-encoded list of objects, the website under that key)
;;   :json-pages  the same, :url ending in 'page=' (pages from 0 until
;;                an empty one)
;;   :xml         :url :org-tag :name-tag :url-tag, optional :type-tag
;;                and :type-filter
;;   :govuk       :list-url :content-url (gov.uk organisations API)
;;   :ptv         :list-url :detail-url :type-filter (Suomi.fi PTV API)
;; Every format takes the optional :host-filter, :exclude-name and
;; :registrable (true: hosts cut to their registrable domain).
;;
;; A key maps to one spec or to a vector of specs, at most one per
;; channel (both would write the same file).
;;
;; Regexes are strings, compiled at load: the filters (:col-filters,
;; :item-filters as [column-or-field regex] pairs, :type-filter,
;; :host-filter, :exclude-name) match with re-find.

{"DE"
 ;; Behördenwegweiser: federal bodies only, but no type column and a
 ;; sprinkling of federally-anchored foundations and associations ->
 ;; candidates, not registry.
 {:channel     :candidates
  :format      :csv
  :url         "https://www.service.bund.de/SharedDocs/CSV/Anschriftenverzeichnis-CSV.csv?__blob=publicationFile"
  :encoding    "ISO-8859-1"
  :separator   ";"
  :name-col    "Organisation"
  :website-col "Internetadresse"}

 "NO"
 ;; Enhetsregisteret: institutional sector code 6100 = central
 ;; government (statsforvaltningen) -- ministries, directorates, courts,
 ;; police districts. Authoritative central scoping -> registry.
 ;; (organisasjonsform STAT alone only carries the ~18 top-level organs.)
 ;; Academia is left to 'bb pipeline academia', whose rows go through
 ;; proposed.csv, not to this registry, which confirms; the \b keeps
 ;; university hospitals (UNIVERSITETSSYKEHUS) in -- Norwegian hospitals
 ;; are central-state bodies. (?iu): plain (?i) does not case-fold Ø/ø.
 {:channel       :registry
  :registry      "brreg"
  :format        :json-pages
  :url           "https://data.brreg.no/enhetsregisteret/api/enheter?institusjonellSektorkode=6100&size=500&page="
  :items-path    [:_embedded :enheter]
  :name-field    :navn
  :website-field :hjemmeside
  :host-filter   "\\.no$"
  :exclude-name  "(?iu)universitetet|universitetssenter|universitet\\b|høgskole|høyskole|fagskole|allaskuvla"}

 "IT"
 ;; IndicePA: 23k+ entities of every level; the category code isolates
 ;; the central ones -- C1 ministries, C2 constitutional organs, C5
 ;; independent authorities, C8 national research bodies (CNR, ISTAT,
 ;; ISS, ASI), C10 fiscal agencies, C11 interior-ministry departments,
 ;; C16 social-security institutes (~130 entities). The categories mix
 ;; a few parapublic bodies -> candidates, curation decides.
 {:channel     :candidates
  :format      :csv
  :url         "https://indicepa.gov.it/ipa-dati/datastore/dump/d09adf99-dc10-4349-8c53-27b1e5aa97b6?format=csv"
  :name-col    "Denominazione_ente"
  :website-col "Sito_istituzionale"
  :col-filters [["Codice_Categoria" "^(?:C1|C2|C5|C8|C10|C11|C16)$"]]}

 "PL"
 ;; Katalog Podmiotów Publicznych: 87k entities of every level (mostly
 ;; schools and municipal bodies), reduced to the ACTIVE central types
 ;; -- ministries, central institutions, top courts, ministry units.
 ;; Deconcentrated field services (district inspectorates, local
 ;; prosecutors...) stay out: their HQs are in 'instytucje centralne'.
 ;; Snapshot resource URL: update it (here and in sources_domains.yaml)
 ;; when dane.gov.pl publishes a new export (dataset 3520). The file is
 ;; UTF-8 with a few stray invalid bytes -> replaced, cosmetic only.
 {:channel     :candidates
  :format      :csv
  :url         "https://api.dane.gov.pl/media/resources/20260529/export_gov.csv"
  :separator   ";"
  :name-col    "Nazwa podmiotu"
  :website-col "Strona www"
  :col-filters [["Status" "^ACTIVE$"]
                ["Typ podmiotu" "^(?:ministerstwa|instytucje centralne|sądy administracyjne|sądy apelacyjne|jednostki organizacyjne (?:Ministerstwa|Kancelarii))"]]}

 "CA"
 ;; Inventory of Federal Organizations and Interests: federal by
 ;; construction, but includes Crown corporations and shared-governance
 ;; interests without a clean central marker -> candidates.
 {:channel     :candidates
  :format      :csv
  :url         "https://open.canada.ca/data/dataset/a35cf382-690c-4221-a971-cf0fd189a46f/resource/7c131a87-7784-4208-8e5c-043451240d95/download/ifoi_roif_en.csv"
  :name-col    "legal_title"
  :website-col "website"}

 "GB"
 ;; gov.uk organisations register: the domains under gov.uk are already
 ;; covered by the CDDO registry; the value is the ~300 'exempt'
 ;; arm's-length bodies running their own website off gov.uk (ukri.org,
 ;; aria.org.uk, acas.org.uk...). Their nature varies (NDPBs, levy
 ;; boards, NI bodies) -> candidates.
 {:channel     :candidates
  :format      :govuk
  :list-url    "https://www.gov.uk/api/organisations?page="
  :content-url "https://www.gov.uk/api/content/government/organisations/"}

 "NL"
 ;; Register van Overheidsorganisaties: full XML dump with clean
 ;; organisation types. The central types below (~325 bodies) leave out
 ;; Gemeente/Provincie/Waterschap and the cooperation vehicles; ZBO's
 ;; and advisory colleges vary in nature -> candidates.
 {:channel     :candidates
  :format      :xml
  :url         "https://organisaties.overheid.nl/archive/exportOO.xml"
  :org-tag     "organisatie"
  :name-tag    "naam"
  :type-tag    "type"
  :url-tag     "url"
  :type-filter "^(?:Ministerie|Agentschap|Inspectie|Zelfstandig bestuursorgaan|Adviescollege|Rechtspraak|Hoog College van Staat)$"}

 "GR"
 ;; Diavgeia (transparency portal) organisations register: 5.4k bodies
 ;; of every level with a category. Kept: ministries, the prime
 ;; minister's offices, general secretariats, independent authorities
 ;; and the courts (central-state bodies, as in the Norwegian and UK
 ;; specs). Left out: NPDD (legal entities of public law, from hospitals
 ;; to municipal foundations), INSTITUTION (mostly municipal
 ;; foundations), universities (bb pipeline academia) and the
 ;; municipalities and regions. Many courts share ministryofjustice.gr
 ;; or a sites.diavgeia.gov.gr page; the empty website is "-" or
 ;; "http://-" -> candidates, host-filtered to .gr.
 {:channel       :candidates
  :format        :json
  :url           "https://diavgeia.gov.gr/luminapi/opendata/organizations.json"
  :items-path    [:organizations]
  :name-field    :label
  :website-field :website
  :item-filters  [[:status "^active$"]
                  [:category "^(?:MINISTRY|PRIME_MINISTER|SECRETARIAT_GENERAL|GENERALGOVERNMENT|INDEPENDENTAUTHORITY|COURT)$"]]
  :host-filter   "\\.gr$"}

 "CO"
 ;; SNIES (higher-education ministry) register of institutions, on the
 ;; national open-data portal (Socrata): sector Oficial = public, with a
 ;; naturaleza_jur_dica (Nacional, Departamental, Municipal) curation
 ;; reads from the evidence; a few sites are "No disponible" or off .co
 ;; -> host-filtered. The private ones (Fundación, Corporación) stay out.
 {:channel       :candidates
  :format        :json
  :url           "https://www.datos.gov.co/resource/n5yy-8nav.json?$limit=5000"
  :items-path    []
  :name-field    :nombre_instituci_n
  :website-field :p_gina_web
  :item-filters  [[:sector "^Oficial$"]]
  :host-filter   "\\.co$"}

 "LV"
 ;; Iestāžu tīmekļvietnes: the state's census of public websites (836
 ;; rows), an XLSX whose columns give the body, its parent body
 ;; (ministry, cabinet, Saeima… or a municipality) and the kind of site.
 ;; Kept: the official sites and the main sites of subordinate bodies
 ;; whose parent is a central one; the municipalities, which the
 ;; environment ministry (VARAM) supervises, are dropped by name.
 ;; Campaign sites, portals and secondary sites stay out. Resource URL
 ;; of the 2020 dataset (annual): update it (here and in
 ;; sources_domains.yaml) when data.gov.lv publishes a new file.
 {:channel      :candidates
  :format       :xlsx
  :url          "https://data.gov.lv/dati/dataset/c058e926-b01e-45a3-8f00-baa4760b0dd0/resource/1300db7b-e498-4110-8016-895cdf83e583/download/tmekvietnes.xlsx"
  :name-col     "Iestādes nosaukums"
  :website-col  "Domēns"
  :col-filters  [["Tīmekļvietnes veids" "OFICIĀLĀ TĪMEKĻVIETNE|GALVENĀ TĪMEKĻVIETNE"]
                 ["Iestādes padotība" "(?iu)ministrija|ministru kabinets|^MK$|saeima|kanceleja|^VARAM$|prezident|tiesa|prokurat"]]
  :exclude-name "(?iu)pašvaldīb|novad|\\bdome\\b|pilsēt"
  :host-filter  "\\.lv$"}

 "FI"
 ;; Suomi.fi Service Catalogue (PTV): 1.8k organisations of every kind
 ;; (municipalities, companies, associations…) with an organizationType;
 ;; State (~105) is the central government, Åland's government included
 ;; -> candidates, curation decides. The listing gives ids and names
 ;; only: the records come 100 at a time from the list endpoint.
 {:channel     :candidates
  :format      :ptv
  :list-url    "https://api.palvelutietovaranto.suomi.fi/api/v11/Organization?page="
  :detail-url  "https://api.palvelutietovaranto.suomi.fi/api/v11/Organization/list?guids="
  :type-filter "^State$"
  :host-filter "\\.(?:fi|ax)$"}

 "FR"
 ;; L'Annuaire de l'administration (DILA), one export, two specs.
 [;; Central administrations and ministries: authoritative -> registry.
  ;; site_internet is a JSON-encoded list of {libelle, valeur}. The .fr
  ;; filter drops the international bodies listed among the websites
  ;; (imf.org, wmo.int…) and the hosts under gouv.fr, curated and
  ;; harvested already (as esr does); the others are cut to their
  ;; registrable domain (engees.unistra.fr -> unistra.fr).
  {:channel          :registry
   :registry         "lannuaire"
   :format           :json
   :url              "https://api-lannuaire.service-public.fr/api/explore/v2.1/catalog/datasets/api-lannuaire-administration/exports/json"
   :query-params     {"select" "nom,site_internet"
                      "where"  "type_organisme=\"Administration centrale (ou Ministère)\""}
   :items-path       []
   :name-field       :nom
   :website-field    :site_internet
   :website-json-key :valeur
   :registrable      true
   :host-filter      "(?<!\\.gouv)\\.fr$"}
  ;; The other State and territorial bodies: operators, deconcentrated
  ;; services, prefectures, regions and departments, independent
  ;; authorities, courts -> candidates, for central-1 among others.
  ;; Left out: central administrations (the registry above), schools
  ;; (bb pipeline academia), embassies, professional orders,
  ;; associations, syndicats mixtes and European institutions.
  {:channel          :candidates
   :format           :json
   :url              "https://api-lannuaire.service-public.fr/api/explore/v2.1/catalog/datasets/api-lannuaire-administration/exports/json"
   :query-params     {"select" "nom,site_internet,type_organisme"
                      "where"  "type_organisme is not null"}
   :items-path       []
   :name-field       :nom
   :website-field    :site_internet
   :website-json-key :valeur
   :item-filters     [[:type_organisme "^(?:Établissement public|Service déconcentré|Préfecture, sous-préfecture|Collectivité locale|Conseil, comité, commission|Direction départementale interministérielle|Service à compétence nationale|Autorité (?:administrative|publique) indépendante|Institution$|Juridiction|Groupement d'intérêt public|Cabinet ministériel|Secrétaire d'État)"]]}]

 "US"
 ;; CISA dotgov-data, current-federal.csv: every federal .gov domain
 ;; (executive, legislative, judicial) -> registry. The clean central
 ;; source for the US, where a bare 'gov' suffix would false-match
 ;; government.com, govtech.io…
 {:channel     :registry
  :registry    "cisa"
  :format      :csv
  :url         "https://raw.githubusercontent.com/cisagov/dotgov-data/main/current-federal.csv"
  :name-col    "Organization name"
  :website-col "Domain name"}}
